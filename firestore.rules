rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny everything
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidPseudo(pseudo) {
      return pseudo is string && pseudo.size() >= 3 && pseudo.size() <= 30 && pseudo.matches('^[a-z0-9_-]+$');
    }

    // Secure isOwner check based strictly on anonymous or standard Auth UID or verified localUid
    function isOwner(pseudo) {
      let metaPath = /databases/$(database)/documents/ghost_metadata/$(pseudo);
      return exists(metaPath) && (
        (request.auth != null && get(metaPath).data.ownerUid == request.auth.uid) ||
        (request.resource != null && request.resource.data != null && request.resource.data.localUid != null && get(metaPath).data.ownerUid == request.resource.data.localUid)
      );
    }

    // 1. PUBLIC GHOST DATA (Routing)
    match /ghosts/{pseudo} {
      allow read: if true;

      allow create: if isValidPseudo(pseudo)
        && request.resource.data.pseudo == pseudo;

      allow update: if request.resource.data.pseudo == resource.data.pseudo
        && (
          // Case 1: Caller is the verified owner (UID matches stored localUid)
          (request.auth != null && resource.data.localUid == request.auth.uid)
          // Case 2: Claiming/proving ownership via verificationPhone matching currentNumber
          || (request.resource.data.verificationPhone != null && request.resource.data.verificationPhone == resource.data.currentNumber)
          // Case 3: Simple toggles if caller UID is owner
          || (request.resource.data.isOnline != null && (request.auth != null && resource.data.localUid == request.auth.uid))
          // Case 4: No change to localUid
          || (request.resource.data.localUid != null && request.resource.data.localUid == resource.data.localUid)
        );

      allow delete: if (request.auth != null && resource.data.localUid == request.auth.uid);
    }

    // 2. PRIVATE GHOST METADATA (Ownership)
    match /ghost_metadata/{pseudo} {
      allow read, write: if true;
    }
  }
}
